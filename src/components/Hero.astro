---
import type { Locale } from '../i18n/translations';
import { useTranslations } from '../i18n/translations';
import HeroDemo from './demo/HeroDemo.vue';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const APP_BASE_URL = 'https://www.skilltreq.app';

// Build translations object for Vue island (demo + goal picker keys)
const translationKeys = [
  // Demo libraries
  'demo.library.calisthenics',
  'demo.library.mobility',
  'demo.library.acrobatics',
  'demo.library.kickboxing',
  // Calisthenics skills
  'demo.skill.ring-support',
  'demo.skill.ring-dip',
  'demo.skill.ring-push-up',
  'demo.skill.ring-pppu',
  'demo.skill.tuck-planche',
  'demo.skill.ring-row',
  'demo.skill.ring-pull-up',
  'demo.skill.ring-mu',
  // Mobility skills
  'demo.skill.90-90-stretch',
  'demo.skill.pigeon-pose',
  'demo.skill.hip-pails-rails',
  'demo.skill.front-split',
  'demo.skill.cat-cow',
  'demo.skill.jefferson-curl',
  'demo.skill.shoulder-cars',
  'demo.skill.full-bridge',
  // Acrobatics skills
  'demo.skill.tmb-cartwheel',
  'demo.skill.tmb-one-hand-cw',
  'demo.skill.tmb-aerial',
  'demo.skill.tmb-round-off',
  'demo.skill.tmb-bridge',
  'demo.skill.tmb-bhs',
  'demo.skill.tmb-back-tuck',
  // Kickboxing skills
  'demo.skill.kb-stance',
  'demo.skill.kb-jab',
  'demo.skill.kb-cross',
  'demo.skill.kb-hook',
  'demo.skill.kb-jch',
  'demo.skill.kb-front-kick',
  'demo.skill.kb-roundhouse',
  // Skill descriptions (for tooltip)
  'demo.desc.ring-support',
  'demo.desc.ring-dip',
  'demo.desc.ring-push-up',
  'demo.desc.ring-pppu',
  'demo.desc.tuck-planche',
  'demo.desc.ring-row',
  'demo.desc.ring-pull-up',
  'demo.desc.ring-mu',
  'demo.desc.90-90-stretch',
  'demo.desc.pigeon-pose',
  'demo.desc.hip-pails-rails',
  'demo.desc.front-split',
  'demo.desc.cat-cow',
  'demo.desc.jefferson-curl',
  'demo.desc.shoulder-cars',
  'demo.desc.full-bridge',
  'demo.desc.tmb-cartwheel',
  'demo.desc.tmb-one-hand-cw',
  'demo.desc.tmb-aerial',
  'demo.desc.tmb-round-off',
  'demo.desc.tmb-bridge',
  'demo.desc.tmb-bhs',
  'demo.desc.tmb-back-tuck',
  'demo.desc.kb-stance',
  'demo.desc.kb-jab',
  'demo.desc.kb-cross',
  'demo.desc.kb-hook',
  'demo.desc.kb-jch',
  'demo.desc.kb-front-kick',
  'demo.desc.kb-roundhouse',
  // Demo statuses
  'demo.status.locked',
  'demo.status.unlocked',
  'demo.status.in_progress',
  'demo.status.completed',
  'demo.status.mastered',
  'demo.tooltip.cta',
  // Goal picker
  'goals.cta.default',
  'goals.cta.selected',
  'goals.roadmap.title',
  'goals.goal.muscle-up',
  'goals.goal.planche',
  'goals.goal.front-split',
  'goals.goal.bridge',
  'goals.goal.aerial-cartwheel',
  'goals.goal.backflip',
  'goals.goal.roundhouse-kick',
  'goals.goal.jab-cross-hook',
] as const;

const translations: Record<string, string> = {};
for (const key of translationKeys) {
  translations[key] = t(key as any);
}
---

<section class="relative overflow-hidden py-20 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h1
        class="hero-enter-lcp text-4xl font-bold tracking-tight text-primary sm:text-5xl lg:text-6xl"
        style="--delay: 0ms"
      >
        {t('hero.headline.pre')}<span class="text-gradient">{t('hero.headline.accent')}</span>{
          t('hero.headline.post')
        }
      </h1>
      <p class="hero-enter mt-6 text-lg text-secondary sm:text-xl" style="--delay: 120ms">
        {t('hero.subtitle')}
      </p>

      <!-- Goal picker prompt -->
      <p class="hero-enter mt-8 text-sm font-medium text-text-muted" style="--delay: 200ms">
        {t('goals.heading' as any)}
      </p>
    </div>

    <!-- Desktop: full tree with goal picker -->
    <div class="hero-enter relative hidden md:block mx-auto mt-8 max-w-4xl" style="--delay: 300ms">
      <div class="demo-glow"></div>

      <!-- Floating badges -->
      <div class="demo-badge" style="top: -0.75rem; left: -2rem; --delay: 500ms; --float-delay: 0s">
        <span class="demo-badge-dot" style="background: var(--status-mastered)"></span>
        {t('demo.status.mastered')}
      </div>
      <div
        class="demo-badge"
        style="top: 1.5rem; right: -2.5rem; --delay: 600ms; --float-delay: 1s"
      >
        <span class="demo-badge-dot" style="background: var(--status-in-progress)"></span>
        {t('demo.status.in_progress')}
      </div>
      <div
        class="demo-badge"
        style="bottom: 2rem; left: -2.75rem; --delay: 700ms; --float-delay: 0.5s"
      >
        <span class="demo-badge-dot" style="background: var(--status-completed)"></span>
        {t('demo.status.completed')}
      </div>
      <div
        class="demo-badge"
        style="bottom: -0.5rem; right: -1.5rem; --delay: 800ms; --float-delay: 1.5s"
      >
        <span class="demo-badge-dot" style="background: var(--status-locked)"></span>
        {t('demo.status.locked')}
      </div>

      <div class="hero-demo-skeleton relative z-[1]">
        <HeroDemo
          client:only="vue"
          translations={translations}
          locale={locale}
          appBaseUrl={APP_BASE_URL}
        />
      </div>
    </div>

    <!-- Mobile: compact tree with goal picker -->
    <div class="hero-enter relative md:hidden mx-auto mt-8 max-w-sm" style="--delay: 300ms">
      <div class="demo-glow"></div>
      <div class="hero-demo-skeleton hero-demo-skeleton--mobile relative z-[1]">
        <HeroDemo
          client:only="vue"
          translations={translations}
          locale={locale}
          appBaseUrl={APP_BASE_URL}
          compact
        />
      </div>
    </div>
  </div>
</section>
