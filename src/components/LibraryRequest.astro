const totalSkills = disciplines.reduce((sum, d) => sum + d.skills, 0);
const totalLibraries = 29;
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="mx-auto max-w-3xl text-center">
      <div
        class="mx-auto mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">
        {t('libraryRequest.heading')}
      </h2>
      <p class="mt-4 text-lg text-secondary">
        {t('libraryRequest.description')}
      </p>
    </div>

    <!-- Discipline grid -->
    <div data-reveal class="mx-auto mt-10 max-w-3xl" style="--delay: 100ms">
      <div class="discipline-grid">
        {
          disciplines.map((d) => (
            <div class="discipline-chip" style={`--chip-color: ${d.color}`}>
              <div class="discipline-chip__icon" set:html={d.icon} />
              <div class="discipline-chip__info">
                <span class="discipline-chip__name">{t(`discipline.${d.id}` as any)}</span>
                <span class="discipline-chip__count">
                  {(t('discipline.skillCount' as any) as string).replace(
                    '{count}',
                    String(d.skills),
                  )}
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-sm text-body">
        {
          (t('libraryRequest.stats' as any) as string)
            .replace('{skills}', String(totalSkills))
            .replace('{libraries}', String(totalLibraries))
        }
      </p>
    </div>

    <div data-reveal class="mt-8 text-center" style="--delay: 200ms">
      <a
        href={mailtoHref}
        class="btn-secondary inline-flex items-center gap-2"
        data-umami-event="library-request"
      >
        {t('libraryRequest.cta')}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .discipline-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .discipline-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .discipline-chip:hover {
    border-color: var(--chip-color);
    transform: translateY(-1px);
  }

  .discipline-chip__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--chip-color) 12%, var(--bg-surface));
    color: var(--chip-color);
    flex-shrink: 0;
  }

  .discipline-chip__icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .discipline-chip__info {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .discipline-chip__name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .discipline-chip__count {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
</style>
