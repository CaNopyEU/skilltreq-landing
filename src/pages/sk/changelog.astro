---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations } from '../../i18n/translations';

const locale = 'sk';
const t = useTranslations(locale);

const entries = await getCollection('changelog');

// Group by ISO week, newest week first; newest change first inside a week.
const weeks = new Map<string, { weekStart: string; items: CollectionEntry<'changelog'>[] }>();
for (const entry of entries) {
  const group = weeks.get(entry.data.week);
  if (group) {
    group.items.push(entry);
  } else {
    weeks.set(entry.data.week, { weekStart: entry.data.weekStart, items: [entry] });
  }
}
const grouped = [...weeks.values()]
  .sort((a, b) => b.weekStart.localeCompare(a.weekStart))
  .map((group) => ({
    weekStart: group.weekStart,
    items: group.items.sort(
      (a, b) => b.data.date.localeCompare(a.data.date) || a.id.localeCompare(b.id),
    ),
  }));

const localeFormat: Record<string, string> = { en: 'en-US', sk: 'sk-SK', cs: 'cs-CZ' };
const formatDate = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString(localeFormat[locale] || 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout
  title={t('changelog.title')}
  description={t('changelog.description')}
  locale={locale}
  currentPath="/changelog/"
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <header class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">
        {t('changelog.title')}
      </h1>
      <p class="mt-3 text-secondary">{t('changelog.intro')}</p>
    </header>

    {
      grouped.length === 0 ? (
        <p class="text-text-muted">{t('changelog.empty')}</p>
      ) : (
        <div class="space-y-10">
          {grouped.map((group) => (
            <section>
              <h2 class="text-xl font-semibold text-primary">
                {t('changelog.weekOf', { date: formatDate(group.weekStart) })}
              </h2>
              <ul class="mt-4 space-y-3">
                {group.items.map((entry) => (
                  <li class="flex flex-wrap items-baseline gap-2">
                    {entry.data.tags.map((tag) => (
                      <span class="rounded-full border border-border px-3 py-1 text-xs font-medium text-text-muted">
                        {t(`changelog.tag.${tag}`)}
                      </span>
                    ))}
                    <span class="text-body">{entry.data.text[locale]}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
